# Every local env file. `.env.example` is generated from titan/config.py, is
# meant to be committed, and CI diffs it against a fresh generation -- so it is
# explicitly re-included rather than swallowed by the wildcard.
.env*
!.env.example

# Database dumps. These hold real lead data -- names, addresses and email
# addresses of businesses that never opted in -- and must never be committed.
backups/
*.sql.gz
