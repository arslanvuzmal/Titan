# ==========================================
# TITAN PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# IMAGES AND PUBLIC ORIGIN
# ------------------------------------------
# Both are declared ${VAR:?} in docker-compose.prod.yml, so the stack refuses
# to start rather than come up half-configured if either is missing.
TITAN_WEB_IMAGE=titan-web:local
# Origin only, no trailing path. Two things read it: the CRM container for
# server-side rendering, and you, when building the web image -- the browser
# bundle needs the same value passed as --build-arg NEXT_PUBLIC_API_URL.
TITAN_PUBLIC_ORIGIN=http://your.server.address

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
POSTGRES_USER=titan
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=titan
DATABASE_URL=postgresql://titan:your_secure_password_here@postgres:5432/titan

# ------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# TEMPORAL CONFIGURATION
# ------------------------------------------
TEMPORAL_HOST=temporal:7233

# ------------------------------------------
# SECURITY & ENCRYPTION
# ------------------------------------------
# Generate a secure 32-byte key for Fernet encryption
TITAN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# ------------------------------------------
# CLERK AUTHENTICATION
# ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key
CLERK_SECRET_KEY=sk_live_your_secret_key

# ------------------------------------------
# OPENAI / LLM API
# ------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------
# INTEGRATIONS (OAuth & APIs)
# ------------------------------------------
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=https://yourdomain.com/api/oauth/hubspot/callback

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=https://yourdomain.com/api/oauth/slack/callback

# ------------------------------------------
# EMAIL (SENDGRID)
# ------------------------------------------
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------
# OBSERVABILITY & TRACING
# ------------------------------------------
# Set this if using Datadog, Jaeger, or Honeycomb OTLP collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otlp-collector:4317
LOG_LEVEL=INFO

# The sending claim. One host may send; see titan/delivery/sending_claim.py.
# Must be stable across container recreation, and different on every estate.
TITAN_SENDER_HOST_ID=change-me-per-host
TITAN_SENDER_HOST_LABEL=
